        <mxCell id="tbl_taller" value="talleres_actividades.taller&#xa;--------------------------------------------&#xa;+ tall_id : INT4 [PK]&#xa;* uzdi_id : INT4 [FK -&gt; uzdi]&#xa;* prsn_id : INT4 [FK -&gt; prsn] (Responsable)&#xa;  tallnmbr : VARCHAR(255)&#xa;  talltema : VARCHAR(255)&#xa;  tallfcha : DATE&#xa;  tallhrin : TIME&#xa;  tallhrfn : TIME&#xa;  estado : CHAR(1) [CHECK 'V','F']&#xa;  fcCrea : TIMESTAMP [NOW()]&#xa;  fcMod : TIMESTAMP [NOW()]" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=0;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#00897B;fontSize=10;" vertex="1" parent="group_actividades">
