        <!-- TITULO GENERAL Y ENCABEZADO METODOLOGIA ING. GUIDO -->
        <mxCell id="title1" value="DIAGRAMA ENTIDAD-RELACIÓN OFICIAL — SISTEMA DE GESTIÓN INTEGRAL UZDI (SNAI - PUCE)&#xa;NOTACIÓN FORMAL Y DIRECTRICES DE CÁTEDRA ING. GUIDO (DDL VERSIÓN 8 + RECUADRO ER CAI)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#1F497D;strokeColor=#102A45;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1080" height="70" as="geometry" />
        </mxCell>

        <!-- LEYENDA Y CRITERIOS TECNICOS -->
        <mxCell id="leyenda" value="NOTAS DE MODELADO Y CONVENCIONES ING. GUIDO:&#xa;• Todas las tablas incluyen obligatoriamente los atributos de auditoría: fcCrea (TIMESTAMP) y fcMod (TIMESTAMP).&#xa;• Estado lógico: estado CHAR(1) ('V'/'F') para borrado lógico uniforme en todas las entidades.&#xa;• Dominio Judicial CONA: medida_expediente desacopla mdso_id de expediente y añade el atributo obligatorio 'orden'.&#xa;• Recuadro de Seguridad ER CAI: prsn, prfl, accn, prms, sesn, prpf para control de acceso dinámico RBAC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B0BEC5;fontColor=#263238;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="30" width="980" height="70" as="geometry" />
        </mxCell>

