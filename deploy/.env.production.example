# Copiar a deploy/.env.production y cambiar TODOS los valores.
# Generar secretos con:  openssl rand -hex 32

POSTGRES_USER=uzdi
POSTGRES_PASSWORD=CAMBIAR_clave_segura_bd
POSTGRES_DB=uzdi_db

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=CAMBIAR_por_openssl_rand_hex_32

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGIN=https://uzdi.ejemplo.gob.ec

# Puertos en localhost del servidor (Nginx publica hacia afuera)
API_PORT_HOST=3000
DB_PORT_HOST=5432
